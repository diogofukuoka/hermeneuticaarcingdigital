rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(data) { return !('userId' in data) || data.userId == request.auth.uid; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function isValidAnalysis(data) {
      return data.keys().hasAll(['title', 'updatedAt', 'userId']) &&
             data.title is string && data.title.size() <= 100 &&
             data.updatedAt is number &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             (!('text' in data) || (data.text is string && data.text.size() <= 50000)) &&
             (!('propositions' in data) || (data.propositions is string && data.propositions.size() <= 100000)) &&
             (!('arcNodes' in data) || (data.arcNodes is string && data.arcNodes.size() <= 100000)) &&
             (!('aiAnalysisText' in data) || (data.aiAnalysisText is string && data.aiAnalysisText.size() <= 100000)) &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 128));
    }

    match /analyses/{analysisId} {
      allow get: if isSignedIn() && isValidId(analysisId) && isOwner(existing());
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(analysisId) && isValidAnalysis(incoming());
      allow update: if isSignedIn() && isValidId(analysisId) && isOwner(existing()) && isValidAnalysis(incoming());
      allow delete: if isSignedIn() && isValidId(analysisId) && existing().userId == request.auth.uid;
    }
  }
}
